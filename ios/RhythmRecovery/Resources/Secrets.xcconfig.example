// Copy this file to Secrets.xcconfig (gitignored) and fill in real values from
// your Supabase project settings (the same project the web app's
// NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY point at).
//
// SUPABASE_PROJECT_HOST is the bare host only -- no "https://", no trailing
// slash, no "/" of any kind. project.yml prepends the scheme when building
// Info.plist's SupabaseURL. (xcconfig treats "//" as a start-of-comment even
// inside a value, and escaping it with "\/" does not survive substitution
// into Info.plist, so a full URL can't live directly in this file.)

SUPABASE_PROJECT_HOST = your-project.supabase.co
SUPABASE_ANON_KEY = your-publishable-anon-key
